# Copie este archivo como .env y ajuste los valores (.env no se versiona).
# Si no existe .env, compose.yaml usa los valores por defecto indicados aquí.

# Puerto del host donde se publica el frontend (Nginx escucha en el 80 del contenedor)
FRONTEND_PORT=8080

# Credenciales de PostgreSQL. Se usan para inicializar la base de datos y para armar DATABASE_URL del backend.
# Importante: POSTGRES_* solo se aplican la primera vez que se inicializa el volumen pgdata.
POSTGRES_USER=appuser
POSTGRES_PASSWORD=rescue123
POSTGRES_DB=appdb
