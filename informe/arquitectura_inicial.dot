digraph inicial {
  rankdir=LR;
  graph [fontname="DejaVu Sans", fontsize=20, nodesep=0.45, ranksep=0.55, pad=0.2,
         label="Arquitectura inicial: conexiones fallidas en rojo y punteadas", labelloc=t];
  node  [fontname="DejaVu Sans", fontsize=18, shape=box, style="rounded,filled", fillcolor="#f4f6f8", color="#555555", margin="0.15,0.08"];
  edge  [fontname="DejaVu Sans", fontsize=16, color="#c0392b", fontcolor="#c0392b", penwidth=2.5, style=dashed];

  nav [label="Navegador\n(host)", shape=ellipse, fillcolor="#ffffff"];

  subgraph cluster_net {
    label="red ..._default (implícita)";
    style="dashed"; color="#888888"; fontcolor="#555555"; fontsize=16; labelloc=b; margin=34;
    fe [label="frontend\nnginx:1.27-alpine\nlisten 80"];
    be [label="backend\npython:3.12-slim\nR-01: CMD app:app\nR-02: sin psycopg2", fillcolor="#fdecea", color="#c0392b"];
    db [label="db\npostgres:16-alpine\nsin healthcheck", shape=cylinder];
  }
  vol [label="R-08: volumen anónimo\n(se pierde en down/up)", shape=folder, fillcolor="#fdecea", color="#c0392b", fontcolor="#c0392b"];

  nav -> fe [label="R-06:\nports\n8080:8080"];
  fe -> be  [label="R-07:\nproxy_pass\nlocalhost:8000"];
  be -> db  [label="R-03: @localhost\nR-04: wrongpass\nR-05: depends_on\nsimple"];
  db -> vol [minlen=0, dir=none];
}
